# Stable Photon Spectrum credentials, from project Settings. Do not use Photon 2.0 Beta keys.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Exact phone (+countrycode, no spaces) or email that sends your iMessages.
ADMIN_IMESSAGE_HANDLE=
# Optional routing for multiple dedicated Photon lines; unnecessary on shared pool.
SPECTRUM_IMESSAGE_PHONE=

OPENAI_API_KEY=
# Choose an available Responses API model supporting Structured Outputs.
OPENAI_MODEL=

# Optional: needed only if you want GitHub PR/issue evidence. Leave both settings blank for ordinary tasks.
# Fine-grained token, only the selected repositories, read permissions only.
GITHUB_TOKEN=
# Comma-separated exact owner/repo names; no wildcards or URLs.
GITHUB_ALLOWED_REPOS=

# Docker Compose local development database only. Use managed DB credentials remotely.
DATABASE_URL=postgresql://deadline_demon:deadline_demon_local_only@127.0.0.1:5433/deadline_demon
DEFAULT_TIMEZONE=Asia/Kolkata
NODE_ENV=development
PORT=3000
WORKER_INTERVAL_MS=30000
# Low-frequency GitHub monitoring; separate deadline milestone jobs remain active.
GITHUB_POLL_INTERVAL_MS=300000
