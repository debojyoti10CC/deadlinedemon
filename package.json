{
  "name": "deadline-demon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "smoke": "tsx scripts/smoke-test.ts",
    "connectivity": "tsx scripts/connectivity.ts",
    "preflight": "tsx scripts/preflight.ts",
    "docs:gallery": "npm run build && node scripts/render-message-gallery.mjs"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "dotenv": "^18.0.8",
    "luxon": "^3.7.2",
    "openai": "^7.38.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "spectrum-ts": "^12.11.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@opentelemetry/core": "2.12.0"
  }
}
